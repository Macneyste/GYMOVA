{
  "name": "gymova",
  "private": true,
  "version": "1.0.0",
  "description": "GYMOVA — AI-powered personal fitness & gym management platform. Train. Eat. Track. Transform.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @gymova/design-tokens -w @gymova/shared-types -w @gymova/shared-validation -w @gymova/fitness-engine -w @gymova/api-client",
    "postinstall": "npm run build:packages",
    "dev:api": "npm run start:dev -w @gymova/api",
    "dev:mobile": "npm run start -w @gymova/mobile",
    "dev:admin": "npm run dev -w @gymova/admin",
    "build": "npm run build:packages && npm run build -w @gymova/api && npm run build -w @gymova/admin",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @gymova/api",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "db:generate": "npm run prisma:generate -w @gymova/api",
    "db:migrate": "npm run prisma:migrate -w @gymova/api",
    "db:deploy": "npm run prisma:deploy -w @gymova/api",
    "db:seed": "npm run prisma:seed -w @gymova/api",
    "db:studio": "npm run prisma:studio -w @gymova/api",
    "db:start": "node scripts/db/local-postgres.mjs start",
    "db:stop": "node scripts/db/local-postgres.mjs stop",
    "db:status": "node scripts/db/local-postgres.mjs status",
    "db:setup-roles": "node scripts/db/setup-roles.mjs",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
