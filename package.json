{
  "name": "gymova",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run start:dev -w @gymova/api",
    "dev:mobile": "npm run start -w @gymova/mobile",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run prisma:generate -w @gymova/api",
    "db:migrate": "npm run prisma:migrate -w @gymova/api",
    "db:seed": "npm run prisma:seed -w @gymova/api"
  },
  "engines": { "node": ">=20" }
}
