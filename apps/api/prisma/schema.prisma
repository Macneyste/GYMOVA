// GYMOVA relational schema — PostgreSQL + Prisma.
// Conventions: UUID ids, UTC timestamps, createdAt/updatedAt, soft-delete only where retention matters.
// Tenant isolation: gymId/branchId appear ONLY on gym-business models. Personal fitness data never needs a gym.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums (mirrored in packages/shared-types/src/enums.ts)
// ============================================================
enum Sex {
  MALE
  FEMALE
  UNSPECIFIED
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum GoalType {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_MUSCLE
  IMPROVE_ENDURANCE
  GENERAL_HEALTH
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum WorkoutTimePreference {
  MORNING
  MIDDAY
  EVENING
  FLEXIBLE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PRE_WORKOUT
  POST_WORKOUT
}

enum WorkoutSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum WorkoutPlanSource {
  GENERATED
  TRAINER
  TEMPLATE
  USER
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  FROZEN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethodType {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum TransactionType {
  CHARGE
  REFUND
  ADJUSTMENT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AttendanceMethod {
  QR
  MANUAL
}

enum NotificationType {
  WORKOUT_REMINDER
  MEAL_REMINDER
  HYDRATION_REMINDER
  APPOINTMENT_REMINDER
  SUBSCRIPTION_EXPIRY
  NEW_PLAN
  WEEKLY_PROGRESS
  CHALLENGE
  ACCOUNT
  SYSTEM
}

enum NotificationChannel {
  PUSH
  IN_APP
  EMAIL
}

enum ChallengePeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum ChallengeMetric {
  WORKOUTS_COMPLETED
  WATER_ML
  MEALS_LOGGED
  STREAK_DAYS
  SLEEP_HOURS
}

enum AICoachType {
  DIET
  WORKOUT
  PERSONAL
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum FoodScanStatus {
  PENDING
  PROCESSING
  NEEDS_CONFIRMATION
  CONFIRMED
  FAILED
}

enum FoodVerification {
  VERIFIED
  PENDING
  USER_SUBMITTED
}

enum Cuisine {
  SOMALI
  INTERNATIONAL
}

enum PlannerItemType {
  WAKE_UP
  BREAKFAST
  LUNCH
  SNACK
  PRE_WORKOUT
  WORKOUT
  POST_WORKOUT
  DINNER
  WATER
  SLEEP
  CUSTOM
}

enum PlannerItemStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
}

enum GymStaffRole {
  RECEPTIONIST
  TRAINER
  MANAGER
  GYM_ADMIN
}

enum ThemePreference {
  SYSTEM
  DARK
  LIGHT
}

enum DevicePlatform {
  android
  ios
  web
}

// ============================================================
// Identity & access
// ============================================================
model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  phone                 String?   @unique
  passwordHash          String
  fullName              String
  avatarUrl             String?
  preferredLanguage     String    @default("en")
  themePreference       ThemePreference @default(SYSTEM)
  emailVerifiedAt       DateTime?
  phoneVerifiedAt       DateTime?
  onboardingCompletedAt DateTime?
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  roles                 UserRole[]
  refreshTokens         RefreshToken[]
  verificationTokens    VerificationToken[]
  devices               UserDevice[]
  profile               UserProfile?
  assessments           FitnessAssessment[]
  targetSnapshots       FitnessTargetSnapshot[]
  goals                 FitnessGoal[]
  workoutPlans          WorkoutPlan[]              @relation("PlanOwner")
  authoredPlans         WorkoutPlan[]              @relation("PlanAuthor")
  workoutSessions       WorkoutSession[]
  workoutRecords        WorkoutRecord[]
  foodLogs              FoodLog[]
  waterLogs             WaterLog[]
  mealPlans             MealPlan[]
  aiConversations       AIConversation[]
  aiUsage               AIUsageRecord[]
  aiRecommendations     AIRecommendation[]
  foodScans             FoodScan[]
  weightLogs            WeightLog[]
  bodyMeasurements      BodyMeasurement[]
  progressPhotos        ProgressPhoto[]
  sleepLogs             SleepLog[]
  recoveryLogs          RecoveryLog[]
  habits                Habit[]
  plannerItems          PlannerItem[]
  challengeParticipations ChallengeParticipation[]
  achievements          UserAchievement[]
  notifications         Notification[]
  notificationPreference NotificationPreference?
  gymStaff              GymStaff[]
  trainerProfile        TrainerProfile?
  trainerClients        TrainerClient[]           @relation("ClientUser")
  gymMemberships        GymMember[]
  subscriptions         MembershipSubscription[]
  attendances           Attendance[]
  bookings              TrainingBooking[]         @relation("BookingMember")
  classBookings         GymClassBooking[]
  payments              Payment[]
  invoices              Invoice[]
  auditLogs             AuditLog[]
  submittedFoods        Food[]                    @relation("FoodSubmitter")

  @@index([createdAt])
  @@index([deletedAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  isSystem    Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  family     String    @db.Uuid
  deviceName String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
}

model VerificationToken {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  purpose    VerificationPurpose
  codeHash   String
  target     String
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model UserDevice {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  pushToken String         @unique
  platform  DevicePlatform
  lastSeenAt DateTime      @default(now())
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// Profile, assessment, goals
// ============================================================
model UserProfile {
  userId    String    @id @db.Uuid
  birthDate DateTime? @db.Date
  sex       Sex       @default(UNSPECIFIED)
  country   String?
  city      String?
  bio       String?
  timezone  String    @default("Africa/Mogadishu")
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Each assessment is an immutable snapshot; the newest row is the current one.
model FitnessAssessment {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String                @db.Uuid
  heightCm            Decimal               @db.Decimal(5, 1)
  weightKg            Decimal               @db.Decimal(5, 1)
  targetWeightKg      Decimal?              @db.Decimal(5, 1)
  waistCm             Decimal?              @db.Decimal(5, 1)
  chestCm             Decimal?              @db.Decimal(5, 1)
  armCm               Decimal?              @db.Decimal(5, 1)
  hipCm               Decimal?              @db.Decimal(5, 1)
  thighCm             Decimal?              @db.Decimal(5, 1)
  experience          ExperienceLevel       @default(BEGINNER)
  activityLevel       ActivityLevel         @default(MODERATE)
  primaryGoal         GoalType              @default(GENERAL_HEALTH)
  workoutPreferences  String[]              @default([])
  equipment           String[]              @default([])
  workoutDays         Int[]                 @default([])
  preferredTime       WorkoutTimePreference @default(FLEXIBLE)
  sessionMinutes      Int                   @default(45)
  healthConsentAt     DateTime?
  createdAt           DateTime              @default(now())
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  limitations         HealthLimitation[]
  dietaryPreferences  DietaryPreference[]
  allergies           FoodAllergy[]
  targetSnapshots     FitnessTargetSnapshot[]

  @@index([userId, createdAt(sort: Desc)])
}

model HealthLimitation {
  id           String            @id @default(uuid()) @db.Uuid
  assessmentId String            @db.Uuid
  kind         String // INJURY | LIMITATION | MEDICAL_CONDITION
  label        String
  assessment   FitnessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model DietaryPreference {
  id           String            @id @default(uuid()) @db.Uuid
  assessmentId String            @db.Uuid
  label        String
  assessment   FitnessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model FoodAllergy {
  id           String            @id @default(uuid()) @db.Uuid
  assessmentId String            @db.Uuid
  allergen     String
  severity     String? // MILD | MODERATE | SEVERE
  assessment   FitnessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

/// Stores the formula version and all inputs used, so targets are reproducible and auditable.
model FitnessTargetSnapshot {
  id                    String            @id @default(uuid()) @db.Uuid
  userId                String            @db.Uuid
  assessmentId          String            @db.Uuid
  formulaVersion        String
  inputs                Json
  bmi                   Decimal           @db.Decimal(4, 1)
  bmr                   Int
  tdee                  Int
  calorieTarget         Int
  proteinG              Int
  carbsG                Int
  fatG                  Int
  fiberG                Int
  waterMl               Int
  weeklyWeightChangeKg  Decimal           @db.Decimal(4, 2)
  warnings              String[]          @default([])
  requiresGuidance      Boolean           @default(false)
  isCurrent             Boolean           @default(true)
  createdAt             DateTime          @default(now())
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment            FitnessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
}

model FitnessGoal {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  type        GoalType
  targetValue Decimal?   @db.Decimal(8, 2)
  unit        String?
  targetDate  DateTime?  @db.Date
  status      GoalStatus @default(ACTIVE)
  notes       String?
  achievedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ============================================================
// Exercise catalogue & workouts
// ============================================================
model ExerciseCategory {
  id        String     @id @default(uuid()) @db.Uuid
  slug      String     @unique
  name      String
  nameSo    String?
  exercises Exercise[]
}

model MuscleGroup {
  id        String           @id @default(uuid()) @db.Uuid
  slug      String           @unique
  name      String
  nameSo    String?
  region    String // UPPER | LOWER | CORE | FULL_BODY
  exercises ExerciseMuscle[]
}

model Equipment {
  id        String              @id @default(uuid()) @db.Uuid
  slug      String              @unique
  name      String
  nameSo    String?
  exercises ExerciseEquipment[]
}

model Exercise {
  id              String                @id @default(uuid()) @db.Uuid
  slug            String                @unique
  name            String
  nameSo          String?
  description     String
  descriptionSo   String?
  instructions    String[]
  instructionsSo  String[]              @default([])
  safetyNotes     String[]              @default([])
  difficulty      ExperienceLevel       @default(BEGINNER)
  categoryId      String                @db.Uuid
  recommendedSets Int?
  recommendedReps String?
  mediaImageUrl   String?
  mediaVideoUrl   String?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  category        ExerciseCategory      @relation(fields: [categoryId], references: [id])
  muscles         ExerciseMuscle[]
  equipment       ExerciseEquipment[]
  alternatives    ExerciseAlternative[] @relation("AlternativeOf")
  alternativeFor  ExerciseAlternative[] @relation("AlternativeTo")
  planExercises   WorkoutPlanExercise[]
  sessionExercises WorkoutSessionExercise[]
  records         WorkoutRecord[]

  @@index([categoryId])
  @@index([difficulty])
  @@index([name])
}

model ExerciseMuscle {
  exerciseId    String      @db.Uuid
  muscleGroupId String      @db.Uuid
  isPrimary     Boolean     @default(true)
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
}

model ExerciseEquipment {
  exerciseId  String    @db.Uuid
  equipmentId String    @db.Uuid
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([exerciseId, equipmentId])
  @@index([equipmentId])
}

model ExerciseAlternative {
  exerciseId    String   @db.Uuid
  alternativeId String   @db.Uuid
  exercise      Exercise @relation("AlternativeOf", fields: [exerciseId], references: [id], onDelete: Cascade)
  alternative   Exercise @relation("AlternativeTo", fields: [alternativeId], references: [id], onDelete: Cascade)

  @@id([exerciseId, alternativeId])
}

model WorkoutPlan {
  id          String            @id @default(uuid()) @db.Uuid
  /// null for global templates
  userId      String?           @db.Uuid
  /// trainer who authored the plan (TRAINER source)
  authorId    String?           @db.Uuid
  name        String
  description String?
  goal        GoalType          @default(GENERAL_HEALTH)
  difficulty  ExperienceLevel   @default(BEGINNER)
  weeks       Int               @default(4)
  isTemplate  Boolean           @default(false)
  isActive    Boolean           @default(false)
  source      WorkoutPlanSource @default(GENERATED)
  generatorVersion String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User?             @relation("PlanOwner", fields: [userId], references: [id], onDelete: Cascade)
  author      User?             @relation("PlanAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  days        WorkoutPlanDay[]
  sessions    WorkoutSession[]

  @@index([userId, isActive])
  @@index([isTemplate])
}

model WorkoutPlanDay {
  id        String                @id @default(uuid()) @db.Uuid
  planId    String                @db.Uuid
  dayOfWeek Int // 0 = Sunday … 6 = Saturday
  title     String
  focus     String?
  isRestDay Boolean               @default(false)
  plan      WorkoutPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises WorkoutPlanExercise[]
  sessions  WorkoutSession[]

  @@unique([planId, dayOfWeek])
}

model WorkoutPlanExercise {
  id             String         @id @default(uuid()) @db.Uuid
  planDayId      String         @db.Uuid
  exerciseId     String         @db.Uuid
  order          Int
  sets           Int
  reps           String // "8-12", "10", "30s"
  restSeconds    Int            @default(60)
  targetWeightKg Decimal?       @db.Decimal(6, 2)
  notes          String?
  planDay        WorkoutPlanDay @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id])

  @@index([planDayId, order])
}

model WorkoutSession {
  id              String                   @id @default(uuid()) @db.Uuid
  userId          String                   @db.Uuid
  planId          String?                  @db.Uuid
  planDayId       String?                  @db.Uuid
  /// client-generated id for offline-created sessions (idempotent sync)
  clientId        String?
  name            String
  status          WorkoutSessionStatus     @default(ACTIVE)
  startedAt       DateTime                 @default(now())
  completedAt     DateTime?
  durationSeconds Int?
  totalVolumeKg   Decimal?                 @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            WorkoutPlan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  planDay         WorkoutPlanDay?          @relation(fields: [planDayId], references: [id], onDelete: SetNull)
  exercises       WorkoutSessionExercise[]
  records         WorkoutRecord[]

  @@unique([userId, clientId])
  @@index([userId, status])
  @@index([userId, startedAt(sort: Desc)])
}

model WorkoutSessionExercise {
  id         String         @id @default(uuid()) @db.Uuid
  sessionId  String         @db.Uuid
  exerciseId String         @db.Uuid
  order      Int
  notes      String?
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])
  sets       WorkoutSet[]

  @@index([sessionId, order])
}

model WorkoutSet {
  id                String                 @id @default(uuid()) @db.Uuid
  sessionExerciseId String                 @db.Uuid
  setNumber         Int
  reps              Int?
  weightKg          Decimal?               @db.Decimal(6, 2)
  durationSeconds   Int?
  completed         Boolean                @default(false)
  completedAt       DateTime?
  sessionExercise   WorkoutSessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@unique([sessionExerciseId, setNumber])
}

/// Personal records, one per user+exercise (best estimated 1RM / heaviest set).
model WorkoutRecord {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  exerciseId   String         @db.Uuid
  sessionId    String?        @db.Uuid
  bestWeightKg Decimal        @db.Decimal(6, 2)
  reps         Int
  estimated1Rm Decimal        @db.Decimal(6, 2)
  achievedAt   DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise     Exercise       @relation(fields: [exerciseId], references: [id])
  session      WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, exerciseId])
}

// ============================================================
// Food catalogue & nutrition
// ============================================================
model Food {
  id              String            @id @default(uuid()) @db.Uuid
  slug            String            @unique
  name            String
  category        String
  cuisine         Cuisine           @default(INTERNATIONAL)
  description     String?
  imageUrl        String?
  source          String
  sourceUrl       String?
  verification    FoodVerification  @default(PENDING)
  verifiedAt      DateTime?
  submittedById   String?           @db.Uuid
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  submittedBy     User?             @relation("FoodSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  translations    FoodTranslation[]
  nutrition       FoodNutrition?
  servings        ServingUnit[]
  ingredients     FoodIngredient[]
  logItems        FoodLogItem[]
  mealItems       MealItem[]
  scanItems       FoodScanItem[]

  @@index([category])
  @@index([cuisine])
  @@index([name])
}

model FoodTranslation {
  id          String @id @default(uuid()) @db.Uuid
  foodId      String @db.Uuid
  locale      String // "so"
  name        String
  description String?
  food        Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, locale])
  @@index([name])
}

/// Macronutrients per 100 g. Values come from verified sources, never from an LLM.
model FoodNutrition {
  foodId     String  @id @db.Uuid
  calories   Decimal @db.Decimal(7, 2)
  proteinG   Decimal @db.Decimal(6, 2)
  carbsG     Decimal @db.Decimal(6, 2)
  fatG       Decimal @db.Decimal(6, 2)
  fiberG     Decimal @default(0) @db.Decimal(6, 2)
  sugarG     Decimal? @db.Decimal(6, 2)
  sodiumMg   Decimal? @db.Decimal(8, 2)
  food       Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)
}

model ServingUnit {
  id        String        @id @default(uuid()) @db.Uuid
  foodId    String        @db.Uuid
  label     String // "1 piece", "1 cup cooked"
  labelSo   String?
  grams     Decimal       @db.Decimal(7, 2)
  isDefault Boolean       @default(false)
  food      Food          @relation(fields: [foodId], references: [id], onDelete: Cascade)
  logItems  FoodLogItem[]

  @@index([foodId])
}

model Ingredient {
  id         String           @id @default(uuid()) @db.Uuid
  slug       String           @unique
  name       String
  nameSo     String?
  isAllergen Boolean          @default(false)
  allergenGroup String? // e.g. GLUTEN, DAIRY, NUTS, FISH, EGG, SOY, SHELLFISH
  foods      FoodIngredient[]
}

model FoodIngredient {
  foodId       String     @db.Uuid
  ingredientId String     @db.Uuid
  food         Food       @relation(fields: [foodId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([foodId, ingredientId])
  @@index([ingredientId])
}

model MealPlan {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @db.Uuid
  name               String
  weekStart          DateTime      @db.Date
  dailyCalorieTarget Int
  isActive           Boolean       @default(true)
  generatorVersion   String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  days               MealPlanDay[]

  @@index([userId, isActive])
}

model MealPlanDay {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @db.Uuid
  dayOfWeek Int
  plan      MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  meals     Meal[]

  @@unique([planId, dayOfWeek])
}

model Meal {
  id       String      @id @default(uuid()) @db.Uuid
  dayId    String      @db.Uuid
  mealType MealType
  title    String?
  day      MealPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  items    MealItem[]

  @@index([dayId])
}

model MealItem {
  id       String  @id @default(uuid()) @db.Uuid
  mealId   String  @db.Uuid
  foodId   String  @db.Uuid
  grams    Decimal @db.Decimal(7, 2)
  calories Decimal @db.Decimal(7, 2)
  proteinG Decimal @db.Decimal(6, 2)
  carbsG   Decimal @db.Decimal(6, 2)
  fatG     Decimal @db.Decimal(6, 2)
  meal     Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food     Food    @relation(fields: [foodId], references: [id])

  @@index([mealId])
}

model FoodLog {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  date      DateTime      @db.Date
  mealType  MealType
  loggedAt  DateTime      @default(now())
  source    String        @default("MANUAL") // MANUAL | SCAN | MEAL_PLAN
  scanId    String?       @db.Uuid
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     FoodLogItem[]

  @@index([userId, date])
}

/// Nutrition values are snapshotted at log time so diary history stays stable if a food record changes.
model FoodLogItem {
  id            String       @id @default(uuid()) @db.Uuid
  logId         String       @db.Uuid
  foodId        String       @db.Uuid
  servingUnitId String?      @db.Uuid
  servingLabel  String
  quantity      Decimal      @db.Decimal(6, 2)
  grams         Decimal      @db.Decimal(7, 2)
  calories      Decimal      @db.Decimal(7, 2)
  proteinG      Decimal      @db.Decimal(6, 2)
  carbsG        Decimal      @db.Decimal(6, 2)
  fatG          Decimal      @db.Decimal(6, 2)
  fiberG        Decimal      @db.Decimal(6, 2)
  log           FoodLog      @relation(fields: [logId], references: [id], onDelete: Cascade)
  food          Food         @relation(fields: [foodId], references: [id])
  servingUnit   ServingUnit? @relation(fields: [servingUnitId], references: [id], onDelete: SetNull)

  @@index([logId])
}

model WaterLog {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  date     DateTime @db.Date
  amountMl Int
  loggedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ============================================================
// AI
// ============================================================
model AIConversation {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  coachType AICoachType
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

model AIMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  role           AIMessageRole
  content        String
  references     Json?
  provider       String?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  safetyFlags    String[]       @default([])
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AIRecommendation {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  coachType AICoachType
  kind      String // MEAL | WORKOUT | SCHEDULE | SUMMARY
  payload   Json
  acceptedAt DateTime?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model AIUsageRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  date         DateTime @db.Date
  kind         String // CHAT | SCAN | SUMMARY
  provider     String
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costMicroUsd Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date, kind])
}

model AIConfig {
  id                 String   @id @default("default")
  provider           String   @default("mock")
  chatModel          String   @default("claude-sonnet-5-5")
  visionModel        String   @default("claude-sonnet-5-5")
  dailyMessageLimit  Int      @default(40)
  dailyScanLimit     Int      @default(20)
  maxOutputTokens    Int      @default(700)
  temperature        Decimal  @default(0.4) @db.Decimal(3, 2)
  systemPromptExtra  String?
  isEnabled          Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model FoodScan {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  status        FoodScanStatus @default(PENDING)
  imageKey      String
  imageUrl      String?
  provider      String?
  model         String?
  rawResponse   Json?
  failureReason String?
  confirmedLogId String?       @db.Uuid
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         FoodScanItem[]

  @@index([userId, createdAt(sort: Desc)])
}

model FoodScanItem {
  id                 String   @id @default(uuid()) @db.Uuid
  scanId             String   @db.Uuid
  label              String
  confidence         Decimal  @db.Decimal(4, 3)
  foodId             String?  @db.Uuid
  estimatedGrams     Int?
  estimatedGramsLow  Int?
  estimatedGramsHigh Int?
  ingredients        String[] @default([])
  scan               FoodScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  food               Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([scanId])
}

// ============================================================
// Progress & lifestyle
// ============================================================
model WeightLog {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  weightKg Decimal  @db.Decimal(5, 1)
  loggedAt DateTime @default(now())
  note     String?
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt(sort: Desc)])
}

model BodyMeasurement {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  measuredAt DateTime @default(now())
  waistCm    Decimal? @db.Decimal(5, 1)
  chestCm    Decimal? @db.Decimal(5, 1)
  armCm      Decimal? @db.Decimal(5, 1)
  hipCm      Decimal? @db.Decimal(5, 1)
  thighCm    Decimal? @db.Decimal(5, 1)
  bodyFatPct Decimal? @db.Decimal(4, 1)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt(sort: Desc)])
}

/// Private health-related media. Stored under a per-user key prefix; served only via signed/authorized URLs.
model ProgressPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  imageKey  String
  takenAt   DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt(sort: Desc)])
}

model SleepLog {
  id      String   @id @default(uuid()) @db.Uuid
  userId  String   @db.Uuid
  date    DateTime @db.Date
  hours   Decimal  @db.Decimal(4, 2)
  quality Int?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model RecoveryLog {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  date     DateTime @db.Date
  energy   Int
  fatigue  Int
  soreness Int?
  note     String?
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Habit {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @db.Uuid
  name          String
  icon          String?
  targetPerWeek Int        @default(7)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          HabitLog[]

  @@index([userId, isActive])
}

model HabitLog {
  id      String   @id @default(uuid()) @db.Uuid
  habitId String   @db.Uuid
  date    DateTime @db.Date
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model PlannerItem {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  date            DateTime          @db.Date
  type            PlannerItemType
  title           String
  scheduledAt     DateTime
  status          PlannerItemStatus @default(PENDING)
  completedAt     DateTime?
  reminderEnabled Boolean           @default(true)
  reminderSentAt  DateTime?
  payload         Json?
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([scheduledAt, reminderEnabled, reminderSentAt])
}

// ============================================================
// Challenges & achievements
// ============================================================
model Challenge {
  id               String                   @id @default(uuid()) @db.Uuid
  title            String
  titleSo          String?
  description      String
  descriptionSo    String?
  period           ChallengePeriod
  metric           ChallengeMetric
  targetValue      Int
  startsAt         DateTime
  endsAt           DateTime
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  participations   ChallengeParticipation[]

  @@index([isActive, startsAt, endsAt])
}

model ChallengeParticipation {
  id          String    @id @default(uuid()) @db.Uuid
  challengeId String    @db.Uuid
  userId      String    @db.Uuid
  progress    Int       @default(0)
  completedAt DateTime?
  joinedAt    DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
}

model Achievement {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique
  title       String
  titleSo     String?
  description String
  descriptionSo String?
  icon        String
  users       UserAchievement[]
}

model UserAchievement {
  userId        String      @db.Uuid
  achievementId String      @db.Uuid
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

// ============================================================
// Gym management (multi-tenant)
// ============================================================
model Gym {
  id            String                   @id @default(uuid()) @db.Uuid
  name          String
  slug          String                   @unique
  description   String?
  logoUrl       String?
  phone         String?
  email         String?
  currency      String                   @default("USD")
  timezone      String                   @default("Africa/Mogadishu")
  isActive      Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  branches      GymBranch[]
  staff         GymStaff[]
  trainers      TrainerProfile[]
  members       GymMember[]
  plans         MembershipPlan[]
  subscriptions MembershipSubscription[]
  attendances   Attendance[]
  bookings      TrainingBooking[]
  classes       GymClass[]
  payments      Payment[]
  invoices      Invoice[]
  transactions  Transaction[]
  paymentMethods PaymentMethod[]
  auditLogs     AuditLog[]
}

model GymBranch {
  id           String       @id @default(uuid()) @db.Uuid
  gymId        String       @db.Uuid
  name         String
  address      String
  city         String
  country      String
  latitude     Decimal?     @db.Decimal(9, 6)
  longitude    Decimal?     @db.Decimal(9, 6)
  phone        String?
  openingHours Json         @default("[]")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  gym          Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  staff        GymStaff[]
  attendances  Attendance[]
  classes      GymClass[]
  members      GymMember[]

  @@index([gymId])
  @@index([city])
}

model GymStaff {
  id        String       @id @default(uuid()) @db.Uuid
  gymId     String       @db.Uuid
  branchId  String?      @db.Uuid
  userId    String       @db.Uuid
  role      GymStaffRole
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  gym       Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branch    GymBranch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId])
  @@index([userId])
}

model TrainerProfile {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @unique @db.Uuid
  gymId              String?               @db.Uuid
  bio                String?
  specialties        String[]              @default([])
  certifications     String[]              @default([])
  yearsExperience    Int                   @default(0)
  hourlyRate         Decimal?              @db.Decimal(10, 2)
  currency           String                @default("USD")
  isAcceptingClients Boolean               @default(true)
  isActive           Boolean               @default(true)
  ratingAvg          Decimal?              @db.Decimal(3, 2)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym                Gym?                  @relation(fields: [gymId], references: [id], onDelete: SetNull)
  clients            TrainerClient[]
  availability       TrainerAvailability[]
  bookings           TrainingBooking[]
  classes            GymClass[]

  @@index([gymId, isActive])
}

model TrainerClient {
  id         String         @id @default(uuid()) @db.Uuid
  trainerId  String         @db.Uuid
  userId     String         @db.Uuid
  assignedAt DateTime       @default(now())
  endedAt    DateTime?
  notes      String?
  trainer    TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  user       User           @relation("ClientUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainerId, userId])
  @@index([userId])
}

model TrainerAvailability {
  id        String         @id @default(uuid()) @db.Uuid
  trainerId String         @db.Uuid
  dayOfWeek Int
  startTime String // "08:00"
  endTime   String // "12:00"
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, dayOfWeek])
}

model GymMember {
  id         String     @id @default(uuid()) @db.Uuid
  gymId      String     @db.Uuid
  branchId   String?    @db.Uuid
  userId     String     @db.Uuid
  memberCode String
  joinedAt   DateTime   @default(now())
  notes      String?
  isActive   Boolean    @default(true)
  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branch     GymBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId])
  @@unique([gymId, memberCode])
  @@index([userId])
}

model MembershipPlan {
  id            String                   @id @default(uuid()) @db.Uuid
  gymId         String                   @db.Uuid
  name          String
  description   String?
  durationDays  Int
  price         Decimal                  @db.Decimal(12, 2)
  currency      String                   @default("USD")
  features      String[]                 @default([])
  isActive      Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  gym           Gym                      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subscriptions MembershipSubscription[]

  @@index([gymId, isActive])
}

model MembershipSubscription {
  id          String             @id @default(uuid()) @db.Uuid
  gymId       String             @db.Uuid
  userId      String             @db.Uuid
  planId      String             @db.Uuid
  status      SubscriptionStatus @default(PENDING)
  startsAt    DateTime
  endsAt      DateTime
  autoRenew   Boolean            @default(false)
  cancelledAt DateTime?
  frozenUntil DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  gym         Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        MembershipPlan     @relation(fields: [planId], references: [id])
  payments    Payment[]
  invoices    Invoice[]

  @@index([gymId, status, endsAt])
  @@index([userId, status])
}

model Attendance {
  id           String           @id @default(uuid()) @db.Uuid
  gymId        String           @db.Uuid
  branchId     String           @db.Uuid
  userId       String           @db.Uuid
  method       AttendanceMethod @default(QR)
  checkedInAt  DateTime         @default(now())
  checkedOutAt DateTime?
  verifiedById String?          @db.Uuid
  gym          Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branch       GymBranch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId, checkedInAt(sort: Desc)])
  @@index([userId, checkedInAt(sort: Desc)])
}

model TrainingBooking {
  id        String         @id @default(uuid()) @db.Uuid
  gymId     String?        @db.Uuid
  trainerId String         @db.Uuid
  memberId  String         @db.Uuid
  startsAt  DateTime
  endsAt    DateTime
  status    BookingStatus  @default(PENDING)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  gym       Gym?           @relation(fields: [gymId], references: [id], onDelete: SetNull)
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  member    User           @relation("BookingMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([trainerId, startsAt])
  @@index([memberId, startsAt])
}

model GymClass {
  id          String            @id @default(uuid()) @db.Uuid
  gymId       String            @db.Uuid
  branchId    String            @db.Uuid
  trainerId   String?           @db.Uuid
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int               @default(20)
  isCancelled Boolean           @default(false)
  createdAt   DateTime          @default(now())
  gym         Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branch      GymBranch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  trainer     TrainerProfile?   @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  bookings    GymClassBooking[]

  @@index([gymId, startsAt])
}

model GymClassBooking {
  classId  String   @db.Uuid
  userId   String   @db.Uuid
  bookedAt DateTime @default(now())
  class    GymClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
}

// ============================================================
// Finance
// ============================================================
model PaymentMethod {
  id        String            @id @default(uuid()) @db.Uuid
  gymId     String            @db.Uuid
  type      PaymentMethodType
  label     String // "Cash desk", "EVC Plus", "Zaad"
  details   Json?
  isActive  Boolean           @default(true)
  gym       Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([gymId])
}

model Payment {
  id              String                  @id @default(uuid()) @db.Uuid
  gymId           String                  @db.Uuid
  userId          String                  @db.Uuid
  subscriptionId  String?                 @db.Uuid
  paymentMethodId String?                 @db.Uuid
  method          PaymentMethodType
  amount          Decimal                 @db.Decimal(12, 2)
  currency        String                  @default("USD")
  status          PaymentStatus           @default(PENDING)
  reference       String?
  idempotencyKey  String?                 @unique
  recordedById    String?                 @db.Uuid
  paidAt          DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  gym             Gym                     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription    MembershipSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentMethod   PaymentMethod?          @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  transactions    Transaction[]
  invoice         Invoice?

  @@index([gymId, createdAt(sort: Desc)])
  @@index([userId])
}

model Invoice {
  id             String                  @id @default(uuid()) @db.Uuid
  number         String                  @unique
  gymId          String                  @db.Uuid
  userId         String                  @db.Uuid
  subscriptionId String?                 @db.Uuid
  paymentId      String?                 @unique @db.Uuid
  status         InvoiceStatus           @default(DRAFT)
  subtotal       Decimal                 @db.Decimal(12, 2)
  tax            Decimal                 @default(0) @db.Decimal(12, 2)
  total          Decimal                 @db.Decimal(12, 2)
  currency       String                  @default("USD")
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime                @default(now())
  gym            Gym                     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   MembershipSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payment        Payment?                @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  lines          InvoiceLine[]

  @@index([gymId, createdAt(sort: Desc)])
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Append-only ledger of money movements.
model Transaction {
  id        String          @id @default(uuid()) @db.Uuid
  gymId     String          @db.Uuid
  paymentId String          @db.Uuid
  type      TransactionType
  amount    Decimal         @db.Decimal(12, 2)
  currency  String
  note      String?
  createdAt DateTime        @default(now())
  gym       Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payment   Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([gymId, createdAt(sort: Desc)])
}

/// Replay protection for financial POST requests.
model IdempotencyKey {
  key          String   @id
  userId       String   @db.Uuid
  scope        String
  responseJson Json
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// Platform
// ============================================================
model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
}

model NotificationPreference {
  userId               String   @id @db.Uuid
  workoutReminders     Boolean  @default(true)
  mealReminders        Boolean  @default(true)
  hydrationReminders   Boolean  @default(true)
  appointmentReminders Boolean  @default(true)
  subscriptionAlerts   Boolean  @default(true)
  weeklyProgress       Boolean  @default(true)
  challengeUpdates     Boolean  @default(true)
  marketing            Boolean  @default(false)
  quietHoursStart      String?
  quietHoursEnd        String?
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  gymId      String?  @db.Uuid
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  gym        Gym?     @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@index([gymId])
  @@index([entity, entityId])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
