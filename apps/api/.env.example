# ---- Runtime ----
NODE_ENV=development
PORT=3000
API_PUBLIC_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (admin dashboard). Mobile apps are not CORS-restricted.
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=debug

# ---- Database ----
DATABASE_URL="postgresql://gymova:gymova@localhost:5432/gymova?schema=public"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret-at-least-32-characters"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30
# Secret used to sign short-lived QR membership tokens
QR_TOKEN_SECRET="replace-with-another-random-secret"
# Comma-separated emails that are granted SUPER_ADMIN on first registration (development bootstrap only)
BOOTSTRAP_SUPER_ADMIN_EMAILS=admin@gymova.local

# ---- Redis (optional: enables BullMQ queues; without it jobs run in-process) ----
REDIS_URL=

# ---- Object storage (S3-compatible). Leave STORAGE_DRIVER=local for development. ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gymova
S3_ACCESS_KEY=gymova
S3_SECRET_KEY=gymova-secret
S3_FORCE_PATH_STYLE=true

# ---- Messaging (development uses the console provider which logs OTP codes) ----
EMAIL_PROVIDER=console
SMS_PROVIDER=console
EMAIL_FROM=no-reply@gymova.app

# ---- AI ----
# Providers: mock | anthropic. The mock provider is deterministic and offline (development/tests).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_VISION_MODEL=claude-sonnet-5-5
AI_DAILY_MESSAGE_LIMIT=40
AI_DAILY_SCAN_LIMIT=20

# ---- Push notifications ----
EXPO_ACCESS_TOKEN=
